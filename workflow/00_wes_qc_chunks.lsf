#!/usr/bin/env bash
# =============================================================================
# LSF array over RAW WES pVCF chunks: per-chunk `bcftools stats -s -`.
#
# Sample QC needs genotypes only, not annotations — so we read the immutable
# source pVCFs directly rather than waiting on germline-plp-carrier-nf.
#
# Outputs: <output_root>/results/qc/stats/<chunk>.stats.txt (one per chunk)
# =============================================================================
set -euo pipefail

CONFIG="${CONFIG:-config/config.yaml}"
OUTPUT_ROOT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['project']['output_root'])")"
QUEUE="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['queue'])")"
PROJECT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['project'])")"
CAP="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['array_concurrency_cap'])")"

STATS_DIR="$OUTPUT_ROOT/results/qc/stats"
LSF_LOG_DIR="$OUTPUT_ROOT/logs/qc/lsf"
mkdir -p "$STATS_DIR" "$LSF_LOG_DIR"

# Enumerate the raw pVCF Target chunks from config (auto-resolves latest batch).
CHUNK_LIST="$OUTPUT_ROOT/logs/qc/pvcf_chunks.list"
python -c "
from src.common.config import load, resolve
r = resolve(load('$CONFIG'))
open('$CHUNK_LIST','w').write('\n'.join(str(p) for p in r.wes_chunks) + '\n')
print(f'{len(r.wes_chunks)} chunks from {r.wes_target_dir}')
"
N=$(wc -l < "$CHUNK_LIST")
echo "Chunks to stat: $N"

bsub \
  -J "wes_qc_stats[1-$N]%$CAP" \
  -q "$QUEUE" -P "$PROJECT" \
  -n 2 -R "rusage[mem=4000]" -W "02:00" \
  -o "$LSF_LOG_DIR/stats.%J.%I.out" \
  -e "$LSF_LOG_DIR/stats.%J.%I.err" \
  bash -lc '
    set -euo pipefail
    module load bcftools/1.19 || true
    VCF=$(sed -n "${LSB_JOBINDEX}p" '"$CHUNK_LIST"')
    OUT='"$STATS_DIR"'/$(basename "$VCF" .vcf.gz).stats.txt
    if [[ -s "$OUT" ]]; then echo "SKIP $OUT"; exit 0; fi
    bcftools stats -s - "$VCF" > "$OUT"
  '

echo "Array submitted. When done, run 00_wes_qc_aggregate.sh."
