#!/usr/bin/env bash
# =============================================================================
# STEP-1 GATE — run ONE chunk end-to-end, then STOP.
# Do NOT submit the array until this passes and is reviewed.
#
# Usage (from repo root, on Minerva):
#   bash workflow/02_submit_single.lsf                 # first Target chunk
#   bash workflow/02_submit_single.lsf /abs/path.vcf.gz # specific chunk
# =============================================================================
set -euo pipefail

CONFIG="${CONFIG:-config/config.yaml}"
OUTPUT_ROOT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['project']['output_root'])")"
QUEUE="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['queue'])")"
PROJECT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['project'])")"
WALL="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['walltime'])")"
MEM="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['memory_mb'])")"
FORK="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['resources']['vep']['fork'])")"

TARGET_CHUNK="${1:-}"
if [[ -z "$TARGET_CHUNK" ]]; then
  TARGET_CHUNK="$(python -c "from src.common.config import load, resolve; print(resolve(load('$CONFIG')).wes_chunks[0])")"
fi
echo "Step-1 gate: submitting single-chunk job for $TARGET_CHUNK"

LSF_LOG_DIR="$OUTPUT_ROOT/logs/annotation/lsf"
mkdir -p "$LSF_LOG_DIR"

bsub \
  -J "vep_gate" \
  -q "$QUEUE" -P "$PROJECT" \
  -n "$FORK" -R "span[hosts=1] rusage[mem=$((MEM / FORK))]" \
  -W "$WALL" \
  -o "$LSF_LOG_DIR/gate.%J.out" \
  -e "$LSF_LOG_DIR/gate.%J.err" \
  bash -lc "cd $(pwd) && CONFIG='$CONFIG' OUTPUT_ROOT='$OUTPUT_ROOT' \
    bash workflow/01_norm_vep_chunk.sh '$TARGET_CHUNK'"

echo "Submitted. Monitor with: bjobs -J vep_gate"
echo "When it finishes, review $OUTPUT_ROOT/data/annotated/ and $OUTPUT_ROOT/logs/annotation/"
echo "Do NOT submit 03_submit_array.lsf until this passes review."
