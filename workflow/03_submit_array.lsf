#!/usr/bin/env bash
# =============================================================================
# STEP-2 — LSF job array over all Target chunks. Resume-safe (workers skip
# validated outputs). Only submit after Step-1 gate passes review.
#
# Usage (from repo root, on Minerva):
#   bash workflow/03_submit_array.lsf
# =============================================================================
set -euo pipefail

CONFIG="${CONFIG:-config/config.yaml}"
OUTPUT_ROOT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['project']['output_root'])")"
QUEUE="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['queue'])")"
PROJECT="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['project'])")"
WALL="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['walltime'])")"
MEM="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['memory_mb'])")"
CAP="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['lsf']['array_concurrency_cap'])")"
FORK="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['resources']['vep']['fork'])")"

# --- Enumerate chunks (LSF array element i -> line i of chunks.list) ---
CHUNK_LIST="$OUTPUT_ROOT/logs/annotation/chunks.list"
python -m src.annotation.enumerate_chunks --config "$CONFIG" --out "$CHUNK_LIST"
N=$(wc -l < "$CHUNK_LIST")
echo "Chunks to run: $N (concurrency cap: %$CAP, threads/chunk: $FORK)"

LSF_LOG_DIR="$OUTPUT_ROOT/logs/annotation/lsf"
mkdir -p "$LSF_LOG_DIR"

bsub \
  -J "vep[1-$N]%$CAP" \
  -q "$QUEUE" -P "$PROJECT" \
  -n "$FORK" -R "span[hosts=1] rusage[mem=$((MEM / FORK))]" \
  -W "$WALL" \
  -o "$LSF_LOG_DIR/vep.%J.%I.out" \
  -e "$LSF_LOG_DIR/vep.%J.%I.err" \
  bash -lc '
    set -euo pipefail
    LINE=$(sed -n "${LSB_JOBINDEX}p" '"$CHUNK_LIST"')
    if [[ -z "$LINE" ]]; then echo "empty line for index $LSB_JOBINDEX"; exit 1; fi
    cd '"$(pwd)"' && CONFIG='"$CONFIG"' OUTPUT_ROOT='"$OUTPUT_ROOT"' \
      bash workflow/01_norm_vep_chunk.sh "$LINE"
  '

echo "Array submitted. Monitor: bjobs -A ; failed elements: bhist -a -w -J vep"
echo "Resume-safe: re-running this script skips already-validated chunks."
